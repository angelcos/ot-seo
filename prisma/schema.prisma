generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  DONE
  DELIVERED
}

model WorkOrder {
  id               Int             @id @default(autoincrement())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customerName     String
  customerPhone    String
  vehiclePlate     String?
  vehicleBrand     String
  vehicleModel     String
  vehicleYear      String?
  mileage          Int?
  assignedMechanic String          @default("")
  issueDescription String?
  status           WorkOrderStatus @default(PENDING)
}

model Mechanic {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
